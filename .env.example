PORT=5000

# Database
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=<generate-with: openssl rand -base64 32>

# OAuth
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret
META_ID=your-meta-app-id
META_SECRET=your-meta-app-secret
APPLE_ID=your-apple-client-id
APPLE_SECRET=your-apple-client-secret

# Email
MAIL_HOST=smtp.zoho.com
MAIL_USER=noreply@yourdomain.com
MAIL_PASSWORD=your-smtp-password

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Generate the secret with: openssl rand -base64 32
FILE_URL_SIGNING_KEYS=local-v1:<generated-secret-at-least-32-characters>
FILE_URL_TTL_SECONDS=3600

# Storage
STORAGE_BASE_URL=https://your-storage-service.com/storage
STORAGE_API_KEY=your-storage-api-key
STORAGE_LIMIT_FREE_BYTES=209715200
STORAGE_LIMIT_PRO_BYTES=10737418240
STORAGE_LIMIT_LEGACY_BYTES=10737418240
STORAGE_RESERVATION_TTL_SECONDS=900
# Keep false in production until billing usage reconciliation/backfill is reviewed.
STORAGE_QUOTA_ENFORCEMENT_ENABLED=false

# Cloudflare R2 (Primary Storage - S3 compatible)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-cloudflare-r2-bucket-name
AWS_REGION=auto
# Fallbacks (or standard S3)
AWS_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
AWS_S3_BUCKET_NAME=your-cloudflare-r2-bucket-name

# Hetzner Object Storage (Backup Storage - S3 compatible)
HETZNER_ENDPOINT=https://your-hetzner-endpoint.com
HETZNER_ACCESS_KEY_ID=your-hetzner-access-key-id
HETZNER_SECRET_ACCESS_KEY=your-hetzner-secret-access-key
HETZNER_BUCKET_NAME=your-hetzner-bucket-name

# Cloudinary (required for uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Cloud Storage (optional — legacy reads / GCS→Cloudinary backup worker only)
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_KEY_FILENAME=google-storage.json

# AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_ALT=your-secondary-gemini-api-key
# ── Gemini Model Versions (single source of truth) ──
# Change these to upgrade every Gemini-powered service at once.
GEMINI_MODEL_VERSION=gemini-2.5-flash
GEMINI_LIVE_MODEL_VERSION=gemini-2.5-flash-native-audio-preview-09-2025
VOICE_PROVIDER_DEFAULT=gemini
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ASR_PROVIDER=gemini
ASR_FALLBACK_PROVIDER=gemini_fallback
ASR_GEMINI_PRIMARY_MODEL=gemini-2.5-flash
ASR_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
ASR_SHADOW_ENABLED=false
ASR_SHADOW_PROVIDER=gemini_fallback
AI_SLO_ERROR_RATE_MAX=0.03
AI_SLO_FALLBACK_RATE_MAX=0.25
AI_SLO_P95_LATENCY_MS_MAX=6000
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Memento API
OPENROUTER_CRITICAL_ENABLED=true
OR_MODEL_CHAT_PRIMARY=google/gemma-4-26b-a4b-it
OR_MODEL_CHAT_FALLBACK=google/gemma-4-26b-a4b-it
OR_MODEL_TAGS_PRIMARY=google/gemma-4-26b-a4b-it:free
OR_MODEL_TAGS_FALLBACK=google/gemma-4-26b-a4b-it
OR_MODEL_TRANSCRIPTION_PRIMARY=
OR_MODEL_TRANSCRIPTION_FALLBACK=
PROMPT_VERSION_CHAT_PRIMARY=
PROMPT_VERSION_CHAT_BOOTSTRAP=
PROMPT_VERSION_ONBOARDING_CHAT=
PROMPT_VERSION_TAGS_GENERATE=
PROMPT_VERSION_TRANSCRIPTION=
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_CHAT_PRIMARY=llama-3.1-8b-instant
GROQ_MODEL_CHAT_FALLBACK=llama-3.3-70b-versatile
GROQ_FAST_MODE_ENABLED=true
GROQ_FAST_MODE_MAX_INPUT_CHARS=320
GROQ_MODEL_CHAT_FAST_PRIMARY=llama-3.1-8b-instant
GROQ_MODEL_CHAT_FAST_FALLBACK=llama-3.3-70b-versatile
SUPERMEMORY_API_KEY=your-supermemory-api-key

# Optional Multi-Provider Round-Robin API Keys
CEREBRAS_API_KEY=your-cerebras-api-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
SAMBANOVA_API_KEY=your-sambanova-api-key
CLOUDFLARE_AI_API_KEY=your-cloudflare-ai-api-key
CLOUDFLARE_AI_ACCOUNT_ID=your-cloudflare-account-id

# Webhooks / Notifications
TALLY_WEBHOOK_SECRET=your-tally-webhook-secret
DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...
APPLE_IAP_NOTIFICATIONS_ENABLED=false
APPLE_SHARED_SECRET=
GOOGLE_PLAY_RTDN_ENABLED=false
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
IAP_TOKEN_ENCRYPTION_KEY=

# Dev / Support
DEV_MAILS=dev@yourdomain.com
SUPPORT_MAILS=support@yourdomain.com

# WebAuthn / Passkeys
# Local dev: defaults below work out of the box
# Production: RP_ID = bare domain (e.g. mymemento.io), ORIGIN = full https URL
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Memento
WEBAUTHN_ORIGIN=http://localhost:5173
