<%- include('components/header') %>
  <h1 class="subject">Reset Your Password</h1>
  <%- include('components/greetings', { name }) %>
    <p>
      We received a request to reset your Memento password. Use the verification code below to set a new password:
    </p>
    <%- include('components/code', { code, note: "This code will expire in 10 minutes. Enter it in the app to continue." }) %>
    <p>
      If you didn’t request a password reset, you can safely ignore this email.
    </p>
    <%- include('components/closing-text') %>
<%- include('components/footer') %>
