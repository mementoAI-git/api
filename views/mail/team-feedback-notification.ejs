<%- include('components/header') %>
<%- include('components/title', { text: `New ${label} from`, emphasis: name }) %>
<%- include('components/details', { rows: [['From', userEmail ? `${name} (${userEmail})` : name], ['Type', type], ['Submitted', submittedAt], ['Feedback ID', feedbackId]] }) %>
<div class="quote" style="white-space: pre-wrap;"><%= message %></div>
<% if (screenshotUrl) { %>
  <p class="small muted">Screenshot</p>
  <p><a href="<%= screenshotUrl %>"><img src="<%= screenshotUrl %>" alt="Screenshot attached to the feedback" width="478" style="display: block; width: 100%; max-width: 478px; height: auto; border: 1px solid #E8E7E6; border-radius: 8px;"></a></p>
<% } %>
<% if (userEmail) { %>
  <%- include('components/btn-link', { title: `Reply to ${name}`, url: `mailto:${userEmail}`, showUrl: false }) %>
<% } %>
<%- include('components/footer') %>
