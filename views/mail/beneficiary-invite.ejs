<%- include('components/header') %>
<%- include('components/title', { text: isConnection ? `${inviterName} wants to` : `${inviterName} added you as a`, emphasis: isConnection ? 'connect' : 'connection' }) %>
<%- include('components/greetings') %>
<% if (isConnection) { %>
  <p><%= inviterName %> invited you to connect on Memento, so you can keep memories together in a private shared space.</p>
  <p>You choose what to share. Everything else in your Memento stays private.</p>
<% } else { %>
  <p><%= inviterName %> uses Memento to preserve their stories and added you to their people. Accept the invitation to receive the memories and time capsules they choose to pass on to you.</p>
<% } %>
<%- include('components/btn-link', { title: 'Accept invitation', url }) %>
<p class="small muted">Not expecting this? You can ignore this email and nothing will be shared with you.</p>
<%- include('components/closing-text') %>
<%- include('components/footer') %>
