<%- include('components/header') %>
  <div style="padding: 40px;">
    <% if (name) { %>
      <div style="font-size: 16px; color: #333333; margin-bottom: 20px;">Hello <%= name %>,</div>
      <% } else { %>
        <div style="font-size: 16px; color: #333333; margin-bottom: 20px;">Hello,</div>
        <% } %>

          <div style="font-size: 15px; color: #555555; margin-bottom: 25px; line-height: 1.6;">
            We received a request to reset your password for your Memento account. Click the button below to set a new
            password. If you did not request a password reset, you can safely ignore this email.
          </div>

          <% if (url) { %>
            <div style="text-align: center; margin: 30px 0;">
              <a href="<%= url %>"
                style="display: inline-block; background-color: #000000; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 500; font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;">
                Reset Password
              </a>
            </div>
            <% } %>
  </div>
  <%- include('components/footer') %>