<%- include('components/header') %>
  <h1 class="subject">Reset your Memento password</h1>
  <%- include('components/greetings', { name }) %>
    <p>
      We received a request to reset your Memento password. If this was you, please click on the button below to
      continue:
    </p>

    <%- include('components/btn-link', { title: 'Reset Password' , url }) %>
      <p>
        This link will expire in 10 minutes. If you didn’t request this, please ignore this email, your account is
        safe.
      </p>
      <%- include('components/closing-text') %>
        <%- include('components/footer') %>