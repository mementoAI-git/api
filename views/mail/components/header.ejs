<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Memento</title>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      background-color: #130A08;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    img {
      border: 0;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }

    .container {
      width: 100%;
      max-width: 560px;
    }

    .stage {
      padding: 96px 16px 0 16px;
    }

    .card {
      background-color: #FFFFFF;
      border-radius: 28px;
      padding: 48px 48px 44px 48px;
    }

    .wordmark {
      font-family: "EB Garamond", Garamond, Georgia, "Times New Roman", serif;
      font-weight: 500;
      font-size: 20px;
      line-height: 20px;
      color: #1C1410;
    }

    .title {
      margin: 28px 0 20px 0;
      font-family: "EB Garamond", Garamond, Georgia, "Times New Roman", serif;
      font-weight: 500;
      font-size: 24px;
      line-height: 32px;
      color: #1C1410;
    }

    .title em {
      font-style: italic;
    }

    p,
    li {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 17px;
      line-height: 27px;
      color: #1C1410;
    }

    p {
      margin: 0 0 20px 0;
    }

    ul {
      margin: 0 0 24px 0;
      padding: 0 0 0 22px;
    }

    li {
      margin: 0 0 4px 0;
      padding-left: 4px;
    }

    a {
      color: #E98246;
      text-decoration: underline;
    }

    strong {
      font-weight: 600;
    }

    .muted {
      color: #8C8784;
    }

    .small {
      font-size: 15px;
      line-height: 23px;
    }

    .quote {
      margin: 0 0 24px 0;
      padding: 16px 20px;
      background-color: #F4F4F4;
      border: 1px solid #E8E8E8;
      border-radius: 10px;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 16px;
      line-height: 25px;
      color: #4A4441;
    }

    .details {
      width: 100%;
      margin: 0 0 24px 0;
      background-color: #F4F4F4;
      border: 1px solid #E8E8E8;
      border-radius: 10px;
    }

    .details td {
      padding: 6px 20px;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px;
      line-height: 23px;
      color: #1C1410;
      vertical-align: top;
    }

    .details .label {
      width: 110px;
      color: #8C8784;
    }

    .details .first {
      padding-top: 16px;
    }

    .details .last {
      padding-bottom: 16px;
    }

    .signoff {
      margin: 28px 0 0 0;
    }

    .footer {
      padding: 32px 24px 64px 24px;
    }

    .footer p {
      margin: 0 0 10px 0;
      font-size: 13px;
      line-height: 20px;
      color: #8F8986;
    }

    .footer a {
      color: #B5AFAA;
      text-decoration: underline;
    }

    .preheader {
      display: none !important;
      visibility: hidden;
      mso-hide: all;
      font-size: 1px;
      line-height: 1px;
      max-height: 0;
      max-width: 0;
      opacity: 0;
      overflow: hidden;
    }

    @media screen and (max-width: 600px) {
      .stage {
        padding: 48px 20px 0 20px !important;
      }

      .card {
        padding: 32px 28px 32px 28px !important;
        border-radius: 22px !important;
      }

      .title {
        margin: 24px 0 18px 0 !important;
      }

      .btn-cell {
        display: block !important;
        width: 100% !important;
      }

      .btn-cell a {
        display: block !important;
      }

      .code {
        font-size: 30px !important;
      }

      .footer {
        padding: 28px 20px 48px 20px !important;
      }
    }
  </style>
</head>

<body>
  <% if (preheader) { %>
    <div class="preheader"><%= preheader %>&#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp;</div>
  <% } %>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#130A08" style="width: 100%; background-color: #130A08;">
    <tr>
      <td align="center" valign="top" background="<%= backdropUrl %>" bgcolor="#130A08" style="background-color: #130A08; background-image: url('<%= backdropUrl %>'); background-repeat: repeat-x; background-position: top center;">
        <!--[if gte mso 9]>
        <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="mso-width-percent:1000;height:900px;">
          <v:fill type="tile" src="<%= backdropUrl %>" color="#130A08" />
          <v:textbox inset="0,0,0,0">
        <![endif]-->
        <table role="presentation" class="container" width="560" cellspacing="0" cellpadding="0" border="0">
          <tr>
            <td class="stage">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td class="card" bgcolor="#FFFFFF">
                    <a href="<%= appUrl %>" style="text-decoration: none;">
                      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td style="padding-right: 8px; vertical-align: middle;">
                            <img class="logo-icon" src="<%= logoUrl %>" width="20" height="20" alt="" style="display: block; width: 20px; height: 20px; border-radius: 5px;">
                          </td>
                          <td style="vertical-align: middle;">
                            <span class="wordmark">Memento.</span>
                          </td>
                        </tr>
                      </table>
                    </a>
