<table width="100%" class="code-container" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td class="code-text" align="center">
      <%= code %>
    </td>
  </tr>
</table>
<% if (note) { %>
  <table style="margin-bottom: 24px;" width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td style="font-size: 12px; font-family: Inter; color: #000D4D73;">
        <%= note %>
      </td>
    </tr>
  </table>
  <% } %>