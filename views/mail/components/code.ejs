<table width="100%" class="code-container" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td class="code-text" align="center">
      <%= code %>
    </td>
  </tr>
</table>
<% if (note) { %>
  <table style="margin-bottom: 24px;" width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td style="font-size: 12px; font-family: Inter; color: #000D4D73;">
        <%= note %>
      </td>
    </tr>
  </table>
  <% } %>
    <% if (inviteLink) { %>
      <table style="margin-top: 24px; margin-bottom: 24px;" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td align="center">
            <a href="<%= inviteLink %>"
              style="font-size: 14px; font-family: Inter; color: #0066FF; text-decoration: underline;">
              Click here to create your account
            </a>
          </td>
        </tr>
      </table>
      <% } %>