<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin: 4px 0 14px 0;">
  <tr>
    <td align="center" bgcolor="#F4F4F4" style="padding: 22px 16px; background-color: #F4F4F4; border: 1px solid #E8E8E8; border-radius: 10px;">
      <span class="code" style="font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 36px; line-height: 42px; font-weight: 700; letter-spacing: 2px; color: #E98246;"><%= code %></span>
    </td>
  </tr>
</table>
<% if (typeof note !== 'undefined' && note) { %>
  <p class="small muted"><%= note %></p>
<% } %>
