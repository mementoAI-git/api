{
  "name": "memento",
  "version": "1.0.0",
  "description": "",
  "main": "build/src/index.js",
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10.0.0"
  },
  "resolutions": {
    "mongoose": "^8.13.0"
  },
  "overrides": {
    "mongoose": "^8.13.0"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first build/src/index.js",
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first nodemon src/index.ts",
    "build": "npm run clean && npm run compile && cp -R views build/ && cp -R public build/ && cp -R src/module/api/billing/providers/certs build/src/module/api/billing/providers/",
    "lint": "gts lint",
    "test": "vitest run --sequence.concurrent=false",
    "test:watch": "vitest",
    "test:explore": "vitest run test/prompt",
    "test:referrals": "vitest run test/referrals",
    "referrals:indexes": "ts-node src/module/database/migrations/referral-indexes.ts",
    "test:auth": "vitest run test/auth",
    "explore:seed": "ts-node src/module/database/seed/explore-prompts.seed.ts",
    "explore:catalog": "ts-node src/module/database/seed/explore-catalog.generate.ts",
    "explore:migrate": "ts-node src/module/database/migrations/explore-topics-v2.ts",
    "explore:migrate:reverse": "ts-node src/module/database/migrations/explore-topics-v2.ts --reverse",
    "verify": "yarn lint && yarn compile && yarn test",
    "clean": "gts clean",
    "compile": "tsc -p tsconfig.json",
    "fix": "gts fix",
    "worker": "NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/workers/index.ts",
    "worker:prod": "node --dns-result-order=ipv4first build/src/workers/index.js",
    "migrations:up": "ts-node src/migrations/run.ts up",
    "migrations:status": "ts-node src/migrations/run.ts status",
    "migrations:up:prod": "node build/src/migrations/run.js up",
    "migrations:status:prod": "node build/src/migrations/run.js status",
    "files:audit-access": "ts-node src/scripts/file-access-audit.ts",
    "compat:report": "ts-node src/scripts/compatibility-report.ts",
    "voice:memory-probe": "ts-node src/scripts/voice-memory-probe.ts",
    "memory:backfill-embeddings": "ts-node src/scripts/backfill-memory-embeddings.ts",
    "memory:backfill-embeddings:prod": "node build/src/scripts/backfill-memory-embeddings.js",
    "files:backfill-thumbnails": "ts-node src/scripts/backfill-thumbnail-keys.ts",
    "explore:upload-artwork": "ts-node src/scripts/upload-explore-artwork.ts",
    "capsules:backfill-recipients": "ts-node src/scripts/backfill-capsule-recipients.ts",
    "contracts:export": "ts-node src/scripts/export-openapi.ts",
    "contracts:check": "ts-node src/scripts/export-openapi.ts --check",
    "test:auth:redis": "node --test -r ts-node/register test/auth/reset-token.integration.ts",
    "search:trial": "ts-node src/scripts/memory-search-trial/index.ts",
    "staff:account": "ts-node src/scripts/staff-account.ts"
  },
  "author": "Frank",
  "license": "MIT",
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "gts": "^6.0.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@bull-board/api": "^6.16.2",
    "@bull-board/express": "^6.16.2",
    "@google-cloud/storage": "^7.14.0",
    "@google/genai": "^1.20.0",
    "@huggingface/transformers": "3.8.1",
    "@simplewebauthn/server": "^13.3.0",
    "@types/ejs": "^3.1.5",
    "archiver": "^8.0.0",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.4",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "elliptic": "^6.6.1",
    "express": "^4.17.21",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "get-audio-duration": "^4.0.1",
    "google-auth-library": "^9.0.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "juice": "^11.0.3",
    "mongoose": "^8.13.0",
    "mongoose-paginate-v2": "^1.9.0",
    "multer": "^2.0.2",
    "music-metadata": "^11.13.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.1",
    "redis": "^5.0.1",
    "sharp": "^0.34.5",
    "speakeasy": "^2.0.0",
    "supermemory": "^4.11.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  }
}
